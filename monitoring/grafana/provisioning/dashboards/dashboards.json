{
	"uid": "transcendence-monitoring",
	"title": "Transcendence - Monitoring",
	"tags": ["transcendence", "monitoring"],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 1,
	"refresh": "10s",
	"time": {
		"from": "now-15m",
		"to": "now"
	},
	"panels": [
		{
			"id": 1,
			"title": "Joueurs connectés",
			"type": "stat",
			"datasource": {"type": "prometheus", "uid": "prometheus"},
			"targets": [{"expr": "game_connected_players", "refId": "A"}],
			"gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}
		},
		{
			"id": 2,
			"title": "Parties actives",
			"type": "stat",
			"datasource": {"type": "prometheus", "uid": "prometheus"},
			"targets": [{"expr": "game_active_rooms", "refId": "A"}],
			"gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}
		},
		{
			"id": 3,
			"title": "Joueurs en attente",
			"type": "stat",
			"datasource": {"type": "prometheus", "uid": "prometheus"},
			"targets": [{"expr": "game_waiting_players", "refId": "A"}],
			"gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}
		},
		{
			"id": 4,
			"title": "Tirs par seconde",
			"type": "timeseries",
			"datasource": {"type": "prometheus", "uid": "prometheus"},
			"targets": [{"expr": "rate(game_player_shots_total[5m])", "refId": "A"}],
			"gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}
		},
		{
			"id": 5,
			"title": "Mouvements par seconde",
			"type": "timeseries",
			"datasource": {"type": "prometheus", "uid": "prometheus"},
			"targets": [{"expr": "rate(game_player_moves_total[5m])", "refId": "A"}],
			"gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}
		},
		{
			"id": 6,
			"title": "CPU de la VM (%)",
			"type": "timeseries",
			"datasource": {"type": "prometheus", "uid": "prometheus"},
			"targets": [{"expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A"}],
			"gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}
		},
		{
			"id": 7,
			"title": "RAM utilisée (%)",
			"type": "timeseries",
			"datasource": {"type": "prometheus", "uid": "prometheus"},
			"targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A"}],
			"gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}
		},
		{
			"id": 8,
			"title": "État du serveur de jeu",
			"type": "stat",
			"datasource": {"type": "prometheus", "uid": "prometheus"},
			"targets": [{"expr": "up{job=\"game-server\"}", "refId": "A"}],
			"fieldConfig": {
				"defaults": {
					"mappings": [
						{
							"type": "value",
							"options": {
								"0": {"text": "DOWN", "color": "red"},
								"1": {"text": "UP", "color": "green"}
							}
						}
					],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{"color": "red", "value": null},
							{"color": "green", "value": 1}
						]
					}
				},
				"overrides": []
			},
			"gridPos": {"h": 5, "w": 24, "x": 0, "y": 21}
		}
	],
	"annotations": {
		"list": [
			{
				"builtIn": 1,
				"datasource": {"type": "grafana", "uid": "-- Grafana --"},
				"enable": true,
				"hide": true,
				"name": "Annotations & Alerts",
				"type": "dashboard"
			}
		]
	},
	"editable": true,
	"fiscalYearStartMonth": 0,
	"graphTooltip": 0,
	"links": [],
	"liveNow": false
}
